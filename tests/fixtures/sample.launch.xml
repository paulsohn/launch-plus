<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="sensor_model" default="sample_sensor"/>
  <arg name="use_sim" default="false"/>

  <let name="config_dir" value="$(find-pkg-share sample_pkg)/config"/>

  <group if="$(var use_sim)">
    <include file="$(find-pkg-share sample_pkg)/launch/sim.launch.xml">
      <arg name="vehicle_model" value="$(arg vehicle_model)"/>
    </include>
  </group>

  <node pkg="sample_pkg" exec="sample_node" name="sample">
    <param name="config_file" value="$(var config_dir)/params.yaml"/>
    <param name="vehicle_model" value="$(arg vehicle_model)"/>
    <remap from="/input" to="/output"/>
  </node>
</launch>
